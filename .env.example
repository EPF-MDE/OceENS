# Copy this file to `.env` (`cp .env.example .env`): the application and
# docker-compose.yaml read it at startup.

# ┌─ Authentication ──────────────────────────────────────────────────────────┐
# `dev`: dev sign-in (GET /dev/login), with no identity provider. Anyone can
# sign in as anyone: NEVER USE IN PRODUCTION.
# `entra` (default when unset): Microsoft Entra ID, see the section below.
# `dev` is shipped here so that a fork starts without Entra credentials; any
# deployment requires AUTH_MODE unset or `entra` (README checklist).
AUTH_MODE=dev

# Optional key required by the dev sign-in (empty = open sign-in).
# Ignored with AUTH_MODE=entra.
DEV_LOGIN_KEY=

# Allowed e-mail domains, comma-separated.
ALLOWED_DOMAINS=epf.fr,epfedu.fr

# Session cookie signing key. Required with AUTH_MODE=entra (the application
# refuses to start without it); in dev, empty = a random key at each start.
# Set a long random value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Microsoft Entra ID (required with AUTH_MODE=entra) ──────────────────────┐
# Leave commented out in dev mode. Uncomment and fill the four variables for
# AUTH_MODE=entra: the application refuses to start if any of the first three
# is missing.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=
# REDIRECT_URI=https://[CHANGE_THIS]/auth/callback
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Database ────────────────────────────────────────────────────────────────┐
# Directory of the SQLite database (default: database/ at the project root).
# With docker compose, the host directory mounted into the container.
LOCAL_DATABASE_DIR=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ LLM summaries ───────────────────────────────────────────────────────────┐
# Key of the default LLM provider. Empty: the application starts, but requested
# summaries are marked as configuration errors.
LLM_API_KEY=

# The default provider ("Ollama EPF"), created at startup when the database does
# not have it yet. An existing row is never changed: these settings only act on
# a database that does not have it yet. Empty: the value given, the school's LLM.
# API type: ollama, openai or anthropic (default: ollama).
DEFAULT_PROVIDER_API_TYPE=
# Base URL of the API (default: https://locallm.mde.epf.fr/ollama).
DEFAULT_PROVIDER_BASE_URL=
# Model used by default (default: gemma4:26b).
DEFAULT_PROVIDER_MODEL=
# NAME of the variable holding the key, not the key itself (default:
# LLM_API_KEY). It must start with LLM_ or end with _API_KEY.
DEFAULT_PROVIDER_KEY_ENV=

# Set to 1 to start the summaries daemon alongside uvicorn. Set it whenever the
# application is the only process that runs, as with the image or Docker
# Compose: otherwise no summary is ever written. Leave it empty only where
# something else starts `oceens-summaries`, as launch.sh does.
RUN_SUMMARIES_DAEMON=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Behind a proxy that ends TLS ────────────────────────────────────────────┐
# Addresses of the proxies whose X-Forwarded-Proto uvicorn believes,
# comma-separated, or * for any. Behind a proxy that ends TLS, set it to that
# proxy's address as the app sees it: otherwise the pages link their CSS over
# http:// and the browser blocks them. Unset: 127.0.0.1 only, and
# http://localhost:8000 works as before. The Docker image sets * itself; leave
# this commented out, or an empty value here overrides it.
# FORWARDED_ALLOW_IPS=
# └───────────────────────────────────────────────────────────────────────────┘
