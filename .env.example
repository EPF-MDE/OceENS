# Copy this file to `.env` (`cp .env.example .env`): the application and
# docker-compose.yaml read it at startup.

# ┌─ Authentication ──────────────────────────────────────────────────────────┐
# `dev`: dev sign-in (GET /dev/login), with no identity provider. Anyone can
# sign in as anyone: NEVER USE IN PRODUCTION.
# `entra` (default when unset): Microsoft Entra ID, see the section below.
# `dev` is shipped here so that a fork starts without Entra credentials; any
# deployment requires AUTH_MODE unset or `entra` (README checklist).
AUTH_MODE=dev

# Optional key required by the dev sign-in (empty = open sign-in).
# Ignored with AUTH_MODE=entra.
DEV_LOGIN_KEY=

# Allowed e-mail domains, comma-separated.
ALLOWED_DOMAINS=epf.fr,epfedu.fr

# Session cookie signing key. Required with AUTH_MODE=entra (the application
# refuses to start without it); in dev, empty = a random key at each start.
# Set a long random value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Microsoft Entra ID (required with AUTH_MODE=entra) ──────────────────────┐
# Leave commented out in dev mode. Uncomment and fill the four variables for
# AUTH_MODE=entra: the application refuses to start if any of the first three
# is missing.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=
# REDIRECT_URI=https://[CHANGE_THIS]/auth/callback
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Database ────────────────────────────────────────────────────────────────┐
# Directory of the SQLite database (default: database/ at the project root).
# With docker compose, the host directory mounted into the container.
LOCAL_DATABASE_DIR=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ LLM summaries ───────────────────────────────────────────────────────────┐
# Key of the default LLM provider. Empty: the application starts, but requested
# summaries are marked as configuration errors.
LLM_API_KEY=

# Set to 1 to start the summaries daemon alongside uvicorn.
# Leave empty/unset in production (launch.sh already handles the daemon).
RUN_SUMMARIES_DAEMON=
# └───────────────────────────────────────────────────────────────────────────┘
